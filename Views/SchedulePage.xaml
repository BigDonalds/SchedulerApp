<UserControl x:Class="SchedulerApp.Views.SchedulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900"
             Background="#F9FAFB"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.BitmapScalingMode="HighQuality">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ContextMenu x:Key="CellContextMenu">
                <MenuItem Header="✏️  Change Names"
                          FontSize="14"
                          FontWeight="SemiBold"
                          Padding="12,8"
                          Click="ChangeNamesMenuItem_Click"/>
            </ContextMenu>

            <Style x:Key="ScheduleItemCard" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1.5" Opacity="0.06"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#4F46E5"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.1"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Analytics card style -->
            <Style x:Key="AnalyticsCard" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Stat pill style -->
            <Style x:Key="StatPill" TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="MainScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>
            </ScrollViewer.Resources>
            <StackPanel x:Name="MainContainer" Margin="20">
                <Button x:Name="ScheduleBackButton"
                        Content="← Back to Schedules"
                        Style="{StaticResource ModernButton}"
                        Background="#6B7280"
                        HorizontalAlignment="Left"
                        Width="140"
                        Height="36"
                        FontSize="13"
                        Margin="0,0,0,20"
                        Click="ScheduleBackButton_Click"
                        Visibility="Collapsed"/>

                <!-- ==================== SCHEDULE LIST VIEW (Export-style) ==================== -->
                <StackPanel x:Name="ScheduleListView">
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="📋 Schedule Management"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>
                    </StackPanel>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Your Schedules"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="ScheduleCountText"
                                           Text="(0)"
                                           FontSize="12"
                                           Foreground="#6B7280"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0"/>
                            </StackPanel>

                            <ItemsControl x:Name="ScheduleListControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ScheduleItemCard}"
                                                MouseLeftButtonDown="ScheduleItem_MouseLeftButtonDown">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="#111827"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding CreatedDate, StringFormat='Created: {0:MMM dd, yyyy HH:mm}'}"
                                                                   FontSize="11"
                                                                   Foreground="#6B7280"/>
                                                        <TextBlock Text=" • "
                                                                   FontSize="11"
                                                                   Foreground="#6B7280"/>
                                                        <TextBlock Text="{Binding Status}"
                                                                   FontSize="11"
                                                                   FontWeight="Medium">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Incomplete">
                                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="View"
                                                            Style="{StaticResource ModernButton}"
                                                            Width="85"
                                                            Height="32"
                                                            FontSize="11"
                                                            Tag="{Binding Id}"
                                                            Click="ViewSchedule_Click"
                                                            Margin="0,0,6,0">
                                                        <Button.ContentTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="👁️" FontSize="11" Margin="0,0,3,0"/>
                                                                    <TextBlock Text="View" FontSize="11"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </Button.ContentTemplate>
                                                    </Button>

                                                    <Button Content="Rename"
                                                            Style="{StaticResource ModernButton}"
                                                            Width="90"
                                                            Height="32"
                                                            FontSize="11"
                                                            Background="#3B82F6"
                                                            Tag="{Binding Id}"
                                                            Click="RenameSchedule_Click"
                                                            Margin="0,0,6,0">
                                                        <Button.ContentTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="✏️" FontSize="11" Margin="0,0,3,0"/>
                                                                    <TextBlock Text="Rename" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="60"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </Button.ContentTemplate>
                                                    </Button>

                                                    <Button Style="{StaticResource ModernButton}"
                                                            Width="32"
                                                            Height="32"
                                                            Background="#EF4444"
                                                            Tag="{Binding Id}"
                                                            Click="DeleteSchedule_Click"
                                                            Padding="0">
                                                        <TextBlock Text="✕"
                                                                   FontWeight="Bold"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border x:Name="NoSchedulesPanel"
                                    Background="#F8FAFC"
                                    CornerRadius="10"
                                    Padding="24"
                                    Margin="0,12,0,0"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📭"
                                               FontSize="32"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="No schedules yet"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Select a batch in Setup and generate a schedule to get started"
                                               FontSize="12"
                                               Foreground="#6B7280"
                                               TextAlignment="Center"
                                               Margin="0,4,0,0"
                                               Width="320"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== SCHEDULE DETAIL VIEW ==================== -->
                <StackPanel x:Name="ScheduleDetailView" Visibility="Collapsed">
                    <TextBlock x:Name="ScheduleDetailTitle"
                               Text="Schedule Details"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,20"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <TextBlock x:Name="CurrentScheduleName"
                                           Text="Schedule"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="📊 Export as PowerPoint"
                                            Width="180"
                                            Height="36"
                                            Style="{StaticResource ModernButton}"
                                            FontSize="13"
                                            Click="ExportPowerPoint_Click"
                                            Margin="0,0,8,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row/Column controls -->
                            <Border Background="#F8FAFC"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="Rows"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="AddRowButton"
                                                    Content="Add"
                                                    Width="100"
                                                    Height="36"
                                                    Style="{StaticResource ModernButton}"
                                                    FontSize="13"
                                                    Background="#10B981"
                                                    Margin="0,0,8,0"
                                                    Click="AddRowButton_Click"/>
                                            <Button x:Name="DeleteRowButton"
                                                    Content="Delete"
                                                    Width="100"
                                                    Height="36"
                                                    Style="{StaticResource ModernButton}"
                                                    FontSize="13"
                                                    Background="#EF4444"
                                                    Click="DeleteRowButton_Click"/>
                                        </StackPanel>
                                        <TextBlock Text="Adds/removes shift intervals"
                                                   FontSize="11"
                                                   Foreground="#6B7280"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="Columns"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="AddColumnButton"
                                                    Content="Add"
                                                    Width="100"
                                                    Height="36"
                                                    Style="{StaticResource ModernButton}"
                                                    FontSize="13"
                                                    Background="#10B981"
                                                    Margin="0,0,8,0"
                                                    Click="AddColumnButton_Click"/>
                                            <Button x:Name="DeleteColumnButton"
                                                    Content="Delete"
                                                    Width="100"
                                                    Height="36"
                                                    Style="{StaticResource ModernButton}"
                                                    FontSize="13"
                                                    Background="#EF4444"
                                                    Click="DeleteColumnButton_Click"/>
                                        </StackPanel>
                                        <TextBlock Text="Adds/removes days"
                                                   FontSize="11"
                                                   Foreground="#6B7280"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Right-click hint -->
                            <Border Background="#EEF2FF"
                                    CornerRadius="8"
                                    Padding="12,10"
                                    Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💡"
                                               FontSize="16"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="Right-click any cell in the grid to add, remove, or rename people assigned to that shift."
                                               FontSize="13"
                                               Foreground="#4F46E5"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Grid container -->
                            <Border BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="1"
                                    Background="White">
                                <ScrollViewer x:Name="ScheduleDetailScrollViewer"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              PreviewMouseWheel="ScheduleDetailScrollViewer_PreviewMouseWheel">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>
                                    </ScrollViewer.Resources>
                                    <Grid x:Name="ScheduleDetailGrid" Margin="0">
                                    </Grid>
                                </ScrollViewer>
                            </Border>

                            <!-- ==================== ANALYTICS SECTION ==================== -->
                            <Border Style="{StaticResource AnalyticsCard}" Margin="0,8,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="Schedule Analytics"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="#111827"
                                                       VerticalAlignment="Center"/>
                                            <Border Background="#EEF2FF"
                                                    CornerRadius="12"
                                                    Padding="8,3"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="AnalyticsSummaryBadge"
                                                           Text="Balanced"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#4F46E5"/>
                                            </Border>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                x:Name="SortToggleButton"
                                                Content="Sort: Workload"
                                                Width="120"
                                                Height="30"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="#4F46E5"
                                                Background="Transparent"
                                                BorderBrush="#C7D2FE"
                                                BorderThickness="1.5"
                                                Cursor="Hand"
                                                Click="SortToggleButton_Click"
                                                VerticalAlignment="Center"
                                                ToolTip="Toggle between workload and alphabetical order">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="15"
                                                            Padding="12,4">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#EEF2FF"/>
                                                            <Setter TargetName="border" Property="BorderBrush" Value="#4F46E5"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#E0E7FF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>

                                    <!-- Workload summary -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="#F0FDF4"
                                                CornerRadius="10"
                                                Padding="14"
                                                Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="Total Hours Scheduled"
                                                           FontSize="11"
                                                           Foreground="#6B7280"/>
                                                <TextBlock x:Name="TotalHoursText"
                                                           Text="0 hrs"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="#059669"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1"
                                                Background="#FEFCE8"
                                                CornerRadius="10"
                                                Padding="14"
                                                Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="Avg Hours / Person"
                                                           FontSize="11"
                                                           Foreground="#6B7280"/>
                                                <TextBlock x:Name="AvgHoursText"
                                                           Text="0 hrs"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="#D97706"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2"
                                                Background="#FFF7ED"
                                                CornerRadius="10"
                                                Padding="14"
                                                Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="Avg Shifts / Person"
                                                           FontSize="11"
                                                           Foreground="#6B7280"/>
                                                <TextBlock x:Name="AvgShiftsPerPersonText"
                                                           Text="0"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="#EA580C"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="3"
                                                Background="#FDF2F8"
                                                CornerRadius="10"
                                                Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="People Assigned"
                                                           FontSize="11"
                                                           Foreground="#6B7280"/>
                                                <TextBlock x:Name="UniquePeopleText"
                                                           Text="0"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="#DB2777"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Additional analytics row -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="#FDF2F8"
                                                CornerRadius="10"
                                                Padding="14"
                                                Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="Coverage"
                                                           FontSize="11"
                                                           Foreground="#6B7280"/>
                                                <TextBlock x:Name="AnalyticsCoverageText"
                                                           Text="0%"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="#DB2777"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1"
                                                Background="#F0F9FF"
                                                CornerRadius="10"
                                                Padding="14"
                                                Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="Filled / Total Shifts"
                                                           FontSize="11"
                                                           Foreground="#6B7280"/>
                                                <TextBlock x:Name="FilledShiftsText"
                                                           Text="0 / 0"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="#0284C7"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2"
                                                Background="#F5F3FF"
                                                CornerRadius="10"
                                                Padding="14"
                                                Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="Unfilled Shifts"
                                                           FontSize="11"
                                                           Foreground="#6B7280"/>
                                                <TextBlock x:Name="UnfilledShiftsText"
                                                           Text="0"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="#7C3AED"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="3"
                                                Background="#ECFEFF"
                                                CornerRadius="10"
                                                Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="Unassigned People"
                                                           FontSize="11"
                                                           Foreground="#6B7280"/>
                                                <TextBlock x:Name="UnassignedPeopleText"
                                                           Text="0"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="#0891B2"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Per-person workload table -->
                                    <TextBlock Text="Workload Distribution"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"
                                               Margin="0,0,0,10"/>

                                    <ItemsControl x:Name="WorkloadList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8FAFC"
                                                        CornerRadius="8"
                                                        Padding="12,10"
                                                        Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="2*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#111827"
                                                                       VerticalAlignment="Center"/>
                                                            <Border Background="{Binding StatusColor}"
                                                                    CornerRadius="10"
                                                                    Padding="8,2"
                                                                    Margin="8,0,0,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusLabel}"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="White"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding HoursText}"
                                                                   FontSize="13"
                                                                   FontWeight="Bold"
                                                                   Foreground="#374151"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>

                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <Border Background="#E5E7EB"
                                                                    Height="6"
                                                                    CornerRadius="3">
                                                                <Border x:Name="ProgressFill"
                                                                        Background="{Binding BarColor}"
                                                                        CornerRadius="3"
                                                                        HorizontalAlignment="Left"
                                                                        Width="{Binding BarWidth}"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding DetailText}"
                                                                       FontSize="10"
                                                                       Foreground="#6B7280"
                                                                       Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Suggestions -->
                                    <TextBlock Text="Suggestions"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"
                                               Margin="0,16,0,10"/>

                                    <ItemsControl x:Name="SuggestionsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding SuggestionBg}"
                                                        CornerRadius="8"
                                                        Padding="12,10"
                                                        Margin="0,0,0,6"
                                                        BorderBrush="{Binding SuggestionBorder}"
                                                        BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Icon}"
                                                                   FontSize="16"
                                                                   Margin="0,1,10,0"
                                                                   VerticalAlignment="Top"/>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Message}"
                                                                   FontSize="13"
                                                                   Foreground="#374151"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="NoSuggestionsText"
                                               Text="Schedule looks well balanced! No suggestions needed."
                                               FontSize="13"
                                               Foreground="#059669"
                                               Margin="0,4,0,0"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- ==================== STAFFING ALERTS SECTION ==================== -->
                            <Border Style="{StaticResource AnalyticsCard}" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Staffing Alerts"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#111827"
                                               Margin="0,0,0,12"/>

                                    <ItemsControl x:Name="StaffingAlertsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding AlertBg}"
                                                        CornerRadius="8"
                                                        Padding="12,10"
                                                        Margin="0,0,0,6"
                                                        BorderBrush="{Binding AlertBorder}"
                                                        BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding AlertTitle}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding AlertTitleColor}"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding AlertDetail}"
                                                                   FontSize="12"
                                                                   Foreground="#374151"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding AlertCandidates}"
                                                                   FontSize="11"
                                                                   Foreground="#6B7280"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,0"
                                                                   Visibility="{Binding CandidatesVisible}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="NoAlertsText"
                                               Text="All shifts fully staffed."
                                               FontSize="13"
                                               Foreground="#059669"
                                               Margin="0,4,0,0"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== SIDE PANEL FOR EDITING NAMES ==================== -->
        <Grid x:Name="EditNamesOverlay" Visibility="Collapsed" Panel.ZIndex="100">
            <Rectangle x:Name="EditNamesOverlayBackground" Fill="#000000" Opacity="0.4"/>

            <Border x:Name="EditNamesPanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Width="440"
                    Background="White"
                    CornerRadius="20,0,0,20"
                    Effect="{StaticResource CardShadow}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="EditNamesPanelTransform" X="440"/>
                </Border.RenderTransform>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Background="#4F46E5"
                            CornerRadius="20,0,0,0"
                            Padding="24,20"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock x:Name="EditNamesTitle"
                                       Text="Edit Shift Names"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock x:Name="EditNamesSubtitle"
                                       Text=""
                                       FontSize="13"
                                       Foreground="#C7D2FE"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Content -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="24">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar">
                                <Setter Property="Width" Value="6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Grid x:Name="GridRoot" Width="6">
                                                <Border x:Name="Border"
                                                        Background="Transparent"
                                                        CornerRadius="3"/>
                                                <Track x:Name="PART_Track" IsDirectionReversed="true">
                                                    <Track.Thumb>
                                                        <Thumb x:Name="Thumb"
                                                               Background="#CBD5E1"
                                                               BorderBrush="Transparent"
                                                               BorderThickness="0">
                                                            <Thumb.Style>
                                                                <Style TargetType="Thumb">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Thumb">
                                                                                <Border x:Name="CornerBorder"
                                                                                        Background="{TemplateBinding Background}"
                                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                                        CornerRadius="3"/>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#94A3B8"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsDragging" Value="True">
                                                                            <Setter Property="Background" Value="#64748B"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Thumb.Style>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ScrollViewer.Resources>
                        <StackPanel>
                            <TextBlock Text="Assigned People"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Margin="0,0,0,12"/>

                            <ItemsControl x:Name="EditNamesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PersonItem}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding}"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,8,0"/>

                                                <Button Grid.Column="1"
                                                        Style="{StaticResource SmallEditButton}"
                                                        Tag="{Binding}"
                                                        Click="EditNameButton_Click"
                                                        Margin="0,0,8,0">
                                                    <TextBlock Text="✏️" FontSize="12"/>
                                                </Button>

                                                <Button Grid.Column="2"
                                                        Style="{StaticResource SmallDeleteButton}"
                                                        Tag="{Binding}"
                                                        Click="RemoveNameButton_Click">
                                                    <TextBlock Text="✕" FontWeight="Bold"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoNamesText"
                                       Text="No people assigned to this shift yet."
                                       FontSize="14"
                                       Foreground="#9CA3AF"
                                       TextAlignment="Center"
                                       Margin="0,20,0,0"
                                       Visibility="Collapsed"/>

                            <Border Background="#F8FAFC"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="Add Person"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"
                                               Margin="0,0,0,12"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="NewNameTextBox"
                                                 Style="{StaticResource RoundedTextBox}"
                                                 Height="40"
                                                 FontSize="14"
                                                 Padding="12,8"
                                                 VerticalContentAlignment="Center"
                                                 KeyDown="NewNameTextBox_KeyDown"/>

                                        <Button Grid.Column="1"
                                                Content="➕ Add"
                                                Width="80"
                                                Height="40"
                                                Style="{StaticResource ModernButton}"
                                                FontSize="13"
                                                Background="#10B981"
                                                Margin="8,0,0,0"
                                                Click="AddNameButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer buttons -->
                    <Border Grid.Row="2"
                            Background="#F8FAFC"
                            CornerRadius="0,0,0,20"
                            Padding="24,20"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel"
                                    Width="100"
                                    Height="40"
                                    Style="{StaticResource ModernButton}"
                                    Background="#6B7280"
                                    Margin="0,0,8,0"
                                    Click="CancelEditNames_Click"/>
                            <Button Content="Confirm"
                                    Width="100"
                                    Height="40"
                                    Style="{StaticResource ModernButton}"
                                    Background="#10B981"
                                    Click="ConfirmEditNames_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>