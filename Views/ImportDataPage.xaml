<UserControl x:Class="SchedulerApp.Views.ImportDataPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>
        </ScrollViewer.Resources>
        <StackPanel>
            <Button x:Name="ImportBackButton"
                    Content="← Back"
                    Style="{StaticResource ModernButton}"
                    Background="#6B7280"
                    HorizontalAlignment="Left"
                    Width="100"
                    Height="36"
                    FontSize="13"
                    Margin="0,0,0,20"
                    Click="BackButton_Click"
                    Visibility="Collapsed"/>

            <TextBlock Text="Import Schedule Data"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#111827"
                       Margin="0,0,0,28"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Choose Import Method"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,20"/>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="Data Source"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Margin="0,0,0,6"/>
                        <ComboBox x:Name="ImportSourceBox"
                                  Style="{StaticResource ModernComboBox}"
                                  ItemContainerStyle="{StaticResource ModernComboBoxItem}"
                                  Width="300"
                                  SelectionChanged="ImportSourceBox_SelectionChanged">
                            <ComboBoxItem Content="📁 Upload CSV File"/>
                            <ComboBoxItem Content="🔗 LettuceMeet Link"/>
                        </ComboBox>
                    </StackPanel>

                    <Border x:Name="FileUploadArea"
                            Style="{StaticResource FileUploadBorder}"
                            MouseLeftButtonDown="UploadArea_MouseLeftButtonDown"
                            Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="📊"
                                       FontSize="48"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,16"/>

                            <TextBlock Text="Upload CSV Schedule File"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="CSV files only"
                                       FontSize="14"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,24"/>

                            <Button Content="Browse CSV Files"
                                    Width="160"
                                    Height="40"
                                    Style="{StaticResource ModernButton}"
                                    Click="BrowseButton_Click"/>

                            <TextBlock Text="Download template for correct format"
                                       FontSize="12"
                                       Foreground="#6B7280"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="LettuceMeetInputArea"
                            Style="{StaticResource Card}"
                            Visibility="Collapsed"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="🔗"
                                           FontSize="20"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <TextBlock Text="LettuceMeet Event Link"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Paste LettuceMeet URL"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Margin="0,0,0,6"/>
                                <Grid>
                                    <TextBox x:Name="LettuceMeetUrlBox"
                                             Style="{StaticResource RoundedTextBox}"
                                             ToolTip="Paste your LettuceMeet event URL (e.g., https://lettucemeet.com/l/abc123)"/>
                                    <TextBlock Text="Paste LettuceMeet URL here"
                                               IsHitTestVisible="False"
                                               FontSize="14"
                                               Foreground="#9CA3AF"
                                               Margin="18,0,0,0"
                                               VerticalAlignment="Center"
                                               Cursor="IBeam">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=LettuceMeetUrlBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Text, ElementName=LettuceMeetUrlBox}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>

                            <Button x:Name="ExtractFromLettuceMeetButton"
                                    Content="Extract Data"
                                    Width="200"
                                    Height="44"
                                    Style="{StaticResource ModernButton}"
                                    FontSize="14"
                                    HorizontalAlignment="Right"
                                    Margin="0,20,0,0"
                                    Click="ExtractFromLettuceMeetButton_Click"/>

                            <Border x:Name="ExtractionStatus"
                                    Background="#EEF2FF"
                                    BorderBrush="#C7D2FE"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,16,0,0"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock x:Name="ExtractionStatusIcon"
                                                   Text="⏳"
                                                   FontSize="16"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock x:Name="ExtractionStatusText"
                                                   Text="Extracting data..."
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#4F46E5"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ExtractionStatusDetails"
                                               Text=""
                                               FontSize="12"
                                               Foreground="#6366F1"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border x:Name="ImportedDataCard"
                    Style="{StaticResource Card}"
                    Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,16">
                        <TextBlock x:Name="ImportStatusIcon"
                                   Text="✅"
                                   FontSize="20"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBlock x:Name="ImportStatusTitle"
                                   Text="Data Extracted"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ImportIcon"
                                   Text="📊"
                                   FontSize="24"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="ImportTitleText"
                                       FontSize="16"
                                       FontWeight="Medium"/>
                            <TextBlock x:Name="ImportDetailsText"
                                       FontSize="14"
                                       Foreground="#64748B"
                                       Margin="0,4,0,0"/>
                            <TextBlock x:Name="ImportStatsText"
                                       FontSize="13"
                                       Foreground="#4F46E5"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Button x:Name="ImportDataButton"
                                    Content="📥 Import"
                                    Width="120"
                                    Height="36"
                                    Style="{StaticResource ModernButton}"
                                    FontSize="13"
                                    Click="ImportDataButton_Click"
                                    Margin="0,0,0,8"/>
                            <Button Content="Delete"
                                    Width="100"
                                    Height="36"
                                    Style="{StaticResource ModernButton}"
                                    FontSize="13"
                                    Background="#EF4444"
                                    Click="ChangeImportButton_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}"
                    Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="Import Formats"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <Border Background="#F8FAFC"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="📁"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="CSV Format Only"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#4F46E5"/>
                            </StackPanel>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="• CSV files (.csv) only"
                                           FontSize="13"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="• Download template below for correct format"
                                           FontSize="13"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="• Two formats supported: time slots or date grid"
                                           FontSize="13"
                                           Margin="0,0,0,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#EEF2FF"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🔗"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="LettuceMeet Integration"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#4F46E5"/>
                            </StackPanel>
                            <TextBlock Text="Automatically extract schedule data from LettuceMeet polls:"
                                       FontSize="13"
                                       Margin="0,0,0,6"/>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="• Paste your LettuceMeet event URL"
                                           FontSize="13"
                                           Margin="0,0,0,2"/>
                                <TextBlock Text="• Automatically extracts all participant availability"
                                           FontSize="13"
                                           Margin="0,0,0,2"/>
                                <TextBlock Text="• Converts times to local timezone"
                                           FontSize="13"
                                           Margin="0,0,0,2"/>
                                <TextBlock Text="• Preserves all scheduling metadata"
                                           FontSize="13"
                                           Margin="0,0,0,2"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Content="Download CSV Template"
                            Width="200"
                            Height="40"
                            Style="{StaticResource ModernButton}"
                            FontSize="13"
                            Click="DownloadSampleButton_Click"
                            Margin="0,16,0,0"/>

                    <TextBlock Text="Download template to see expected CSV format"
                               FontSize="12"
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>