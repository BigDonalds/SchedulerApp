<UserControl x:Class="SchedulerApp.Views.SetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer x:Name="SetupScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>
        </ScrollViewer.Resources>
        <StackPanel>

            <Button x:Name="SetupBackButton"
                    Content="← Back"
                    Style="{StaticResource ModernButton}"
                    Background="#6B7280"
                    HorizontalAlignment="Left"
                    Width="100"
                    Height="36"
                    FontSize="13"
                    Margin="0,0,0,20"
                    Click="BackButton_Click"
                    Visibility="Collapsed"/>

            <TextBlock Text="Schedule Setup"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#111827"
                       Margin="0,0,0,28"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>

                    <TextBlock Text="General Settings"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,20"/>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="Select Batch"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Margin="0,0,0,6"/>
                        <ComboBox x:Name="BatchComboBox"
                                  Style="{StaticResource ModernComboBox}"
                                  ItemContainerStyle="{StaticResource ModernComboBoxItem}"
                                  Width="300"
                                  SelectionChanged="BatchComboBox_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="Weekend Options"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Margin="0,0,0,6"/>
                        <CheckBox x:Name="IncludeWeekendsCheckBox"
                                  Content="Include Saturday and Sunday in schedule"
                                  Style="{StaticResource ModernCheckBox}"
                                  IsChecked="False"/>
                    </StackPanel>

                    <UniformGrid Columns="2" Rows="2">
                        <StackPanel Margin="0,0,16,16">
                            <TextBlock Text="Opening Time"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="OpeningTimeBox"
                                      Style="{StaticResource ModernComboBox}"
                                      ItemContainerStyle="{StaticResource ModernComboBoxItem}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Closing Time"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="ClosingTimeBox"
                                      Style="{StaticResource ModernComboBox}"
                                      ItemContainerStyle="{StaticResource ModernComboBoxItem}"/>
                        </StackPanel>

                        <StackPanel Margin="0,16,16,0">
                            <TextBlock Text="Shift Length (hours)"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="ShiftLengthBox"
                                      Style="{StaticResource ModernComboBox}"
                                      ItemContainerStyle="{StaticResource ModernComboBoxItem}"/>
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="People per Shift"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="PeoplePerShiftBox"
                                      Style="{StaticResource ModernComboBox}"
                                      ItemContainerStyle="{StaticResource ModernComboBoxItem}"/>
                        </StackPanel>
                    </UniformGrid>

                </StackPanel>
            </Border>

            <Button Content="Generate Schedule"
                    Width="220"
                    Height="52"
                    HorizontalAlignment="Right"
                    FontSize="16"
                    Style="{StaticResource ModernButton}"
                    Click="Generate_Click"
                    Margin="0,16,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>