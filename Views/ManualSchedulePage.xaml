<UserControl x:Class="SchedulerApp.Views.ManualSchedulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>
        </ScrollViewer.Resources>
        <StackPanel>
            <Button x:Name="ManualBackButton"
                    Content="← Back"
                    Style="{StaticResource ModernButton}"
                    Background="#6B7280"
                    HorizontalAlignment="Left"
                    Width="100"
                    Height="36"
                    FontSize="13"
                    Margin="0,0,0,20"
                    Click="BackButton_Click"
                    Visibility="Collapsed"/>

            <Button x:Name="BackToDatesButton"
                    Content="← Back to Dates"
                    Style="{StaticResource ModernButton}"
                    Background="#6B7280"
                    HorizontalAlignment="Left"
                    Width="140"
                    Height="36"
                    FontSize="13"
                    Margin="0,0,0,20"
                    Click="BackToDatesButton_Click"
                    Visibility="Collapsed"/>

            <TextBlock Text="👤 Manual Schedule Entry"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#111827"
                       Margin="0,0,0,28"/>

            <Border x:Name="RangeSelectionCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Step 1: Define Schedule Grid"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,20"/>

                    <Border Background="#F8FAFC"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="📅"
                                           FontSize="18"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Select Dates"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Background="#EEF2FF"
                                    BorderBrush="#C7D2FE"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="💡"
                                                   FontSize="16"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Grid Dimensions"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#4F46E5"/>
                                    </StackPanel>
                                    <TextBlock x:Name="GridHintText"
                                               Text="Each selected date will create a column in the schedule grid, and the time range will create the rows. You can select dates by: 1) Clicking individual dates, 2) Holding Ctrl while clicking to select multiple non-consecutive dates, or 3) Clicking and dragging to select a range of consecutive dates. Selected dates will be displayed below."
                                               FontSize="12"
                                               Foreground="#6366F1"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        BorderBrush="#D1D5DB"
                                        BorderThickness="2"
                                        Background="White"
                                        CornerRadius="8"
                                        Padding="24"
                                        Height="400">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0"
                                                Background="#F8FAFC"
                                                CornerRadius="6,6,0,0"
                                                Padding="16"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Button x:Name="PrevMonthButton"
                                                        Grid.Column="0"
                                                        Content="←"
                                                        Width="40"
                                                        Height="40"
                                                        FontSize="18"
                                                        FontWeight="Bold"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="PrevMonthButton_Click"
                                                        Cursor="Hand"
                                                        Foreground="#4F46E5"/>

                                                <TextBlock x:Name="MonthYearDisplay"
                                                           Grid.Column="1"
                                                           Text="January 2024"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Foreground="#1F2937"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>

                                                <Button x:Name="NextMonthButton"
                                                        Grid.Column="2"
                                                        Content="→"
                                                        Width="40"
                                                        Height="40"
                                                        FontSize="18"
                                                        FontWeight="Bold"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="NextMonthButton_Click"
                                                        Cursor="Hand"
                                                        Foreground="#4F46E5"/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="1"
                                                Background="White"
                                                CornerRadius="0,0,6,6"
                                                Padding="8">
                                            <Grid x:Name="CalendarGrid">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <UniformGrid Grid.Row="0" Columns="7" Rows="1" Margin="0,0,0,12">
                                                    <TextBlock Text="Sun" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#6B7280" Margin="2"/>
                                                    <TextBlock Text="Mon" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#6B7280" Margin="2"/>
                                                    <TextBlock Text="Tue" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#6B7280" Margin="2"/>
                                                    <TextBlock Text="Wed" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#6B7280" Margin="2"/>
                                                    <TextBlock Text="Thu" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#6B7280" Margin="2"/>
                                                    <TextBlock Text="Fri" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#6B7280" Margin="2"/>
                                                    <TextBlock Text="Sat" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#6B7280" Margin="2"/>
                                                </UniformGrid>

                                                <UniformGrid x:Name="DaysGrid"
                                                             Grid.Row="1"
                                                             Columns="7"
                                                             Rows="6"
                                                             Margin="0"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                    <TextBlock Text="Selected Dates:"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Margin="0,0,0,8"/>

                                    <Border Background="#F3F4F6"
                                            CornerRadius="6"
                                            Padding="12"
                                            MinHeight="60">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      MaxHeight="100">
                                            <ScrollViewer.Resources>
                                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinnerScrollBar}"/>
                                            </ScrollViewer.Resources>
                                            <WrapPanel x:Name="SelectedDatesPanel">
                                                <TextBlock Text="No dates selected"
                                                           FontSize="12"
                                                           Foreground="#9CA3AF"
                                                           FontStyle="Italic"/>
                                            </WrapPanel>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#F8FAFC"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="⏰"
                                           FontSize="18"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Select Time Range"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="From"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Margin="0,0,0,4"/>
                                    <ComboBox x:Name="StartTimeBox"
                                              Style="{StaticResource TimeComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource ModernComboBoxItem}"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="6:00 AM"/>
                                        <ComboBoxItem Content="7:00 AM"/>
                                        <ComboBoxItem Content="8:00 AM"/>
                                        <ComboBoxItem Content="9:00 AM"/>
                                        <ComboBoxItem Content="10:00 AM"/>
                                        <ComboBoxItem Content="11:00 AM"/>
                                        <ComboBoxItem Content="12:00 PM"/>
                                        <ComboBoxItem Content="1:00 PM"/>
                                        <ComboBoxItem Content="2:00 PM"/>
                                        <ComboBoxItem Content="3:00 PM"/>
                                        <ComboBoxItem Content="4:00 PM"/>
                                        <ComboBoxItem Content="5:00 PM"/>
                                        <ComboBoxItem Content="6:00 PM"/>
                                        <ComboBoxItem Content="7:00 PM"/>
                                        <ComboBoxItem Content="8:00 PM"/>
                                        <ComboBoxItem Content="9:00 PM"/>
                                        <ComboBoxItem Content="10:00 PM"/>
                                        <ComboBoxItem Content="11:00 PM"/>
                                        <ComboBoxItem Content="12:00 AM"/>
                                    </ComboBox>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="→"
                                           FontSize="18"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0"
                                           Foreground="#9CA3AF"/>

                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="To"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Margin="0,0,0,4"/>
                                    <ComboBox x:Name="EndTimeBox"
                                              Style="{StaticResource TimeComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource ModernComboBoxItem}"
                                              SelectedIndex="11">
                                        <ComboBoxItem Content="7:00 AM"/>
                                        <ComboBoxItem Content="8:00 AM"/>
                                        <ComboBoxItem Content="9:00 AM"/>
                                        <ComboBoxItem Content="10:00 AM"/>
                                        <ComboBoxItem Content="11:00 AM"/>
                                        <ComboBoxItem Content="12:00 PM"/>
                                        <ComboBoxItem Content="1:00 PM"/>
                                        <ComboBoxItem Content="2:00 PM"/>
                                        <ComboBoxItem Content="3:00 PM"/>
                                        <ComboBoxItem Content="4:00 PM"/>
                                        <ComboBoxItem Content="5:00 PM"/>
                                        <ComboBoxItem Content="6:00 PM"/>
                                        <ComboBoxItem Content="7:00 PM"/>
                                        <ComboBoxItem Content="8:00 PM"/>
                                        <ComboBoxItem Content="9:00 PM"/>
                                        <ComboBoxItem Content="10:00 PM"/>
                                        <ComboBoxItem Content="11:00 PM"/>
                                        <ComboBoxItem Content="12:00 AM"/>
                                        <ComboBoxItem Content="1:00 AM"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button x:Name="CreateGridButton"
                            Content="Create Schedule Grid"
                            Width="200"
                            Height="44"
                            Style="{StaticResource ModernButton}"
                            FontSize="14"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0"
                            Click="CreateGridButton_Click"/>
                </StackPanel>
            </Border>

            <Border x:Name="ScheduleGridCard"
                    Style="{StaticResource Card}"
                    Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,20">
                        <TextBlock Text="📅 Availability Grid"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="CurrentEmployeeText"
                                   Text="for: New Employee"
                                   FontSize="16"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </StackPanel>

                    <Border Background="#F8FAFC"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Employee Name"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <TextBox x:Name="EmployeeNameBox"
                                         Style="{StaticResource RoundedTextBox}"
                                         ToolTip="Enter the full name of the employee"/>
                                <TextBlock Text="Enter employee name"
                                           IsHitTestVisible="False"
                                           FontSize="14"
                                           Foreground="#9CA3AF"
                                           Margin="18,0,0,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=EmployeeNameBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, ElementName=EmployeeNameBox}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Click or click and drag to select available times"
                               FontSize="14"
                               Foreground="#6B7280"
                               Margin="0,0,0,16"/>

                    <Border BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="1"
                            Background="White">
                        <ScrollViewer x:Name="GridScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      MaxHeight="500">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>
                            </ScrollViewer.Resources>
                            <Grid x:Name="ScheduleGrid" Margin="0">
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,16,0,0">
                        <Button x:Name="SaveAvailabilityButton"
                                Content="Save Availability"
                                Width="180"
                                Height="40"
                                Style="{StaticResource ModernButton}"
                                FontSize="14"
                                Click="SaveAvailability_Click"/>

                        <Button Content="Clear Selection"
                                Width="140"
                                Height="40"
                                Style="{StaticResource ModernButton}"
                                FontSize="14"
                                Background="#6B7280"
                                Click="ClearSelection_Click"
                                Margin="12,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="👥 Manually Entered Availabilities"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="(Will be combined with imported data)"
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </StackPanel>

                    <ItemsControl x:Name="EmployeesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource EmployeeCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,8,0"/>
                                                <Border Style="{StaticResource DataSourceBadge}">
                                                    <TextBlock Text="Manual"
                                                               FontSize="11"
                                                               FontWeight="Medium"
                                                               Foreground="#4F46E5"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DateRange}"
                                                       FontSize="14"
                                                       Foreground="#6B7280"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Style="{StaticResource SmallDeleteButton}"
                                                Tag="{Binding Id}"
                                                Click="DeleteEmployee_Click">
                                            <TextBlock Text="✕"
                                                       FontWeight="Bold"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="NoEmployeesText"
                               Text="No employees added yet. Create a grid and add your first employee above!"
                               FontSize="14"
                               Foreground="#9CA3AF"
                               TextAlignment="Center"
                               Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>